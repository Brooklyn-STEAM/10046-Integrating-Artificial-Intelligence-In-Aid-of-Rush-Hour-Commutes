<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    .right-navbar {
      position: fixed;
      top: 0;
      right: 0;
      left: auto;
      width: 20px; 
      height: 100vh; 
      background-color: #343a40; 
      transition: width 0.3s ease, opacity 0.3s ease; 
      z-index: 1000; 
      opacity: 0.7; 
      overflow: hidden; 
    }

    .right-navbar:hover {
      width: 250px; 
      opacity: 1;
      overflow-y: auto;
    }

    .right-navbar .navbar-brand {
      white-space: nowrap; 
      padding: 10px; 
    }

    .right-navbar .navbar-nav {
      display: none; 
      flex-direction: column;
      padding: 10px;
    }


    .right-navbar:hover .navbar-nav {
      display: flex; 
    }

    .right-navbar .nav-item {
      margin: 5px 0; 
    }

    .right-navbar .dropdown-menu {
      background-color: #ffffff; 
      border: none; 
      display: none; 
    }

    .right-navbar .dropdown-item {
      color: rgb(0, 0, 0); 
    }

    .right-navbar .dropdown-item:hover {
      background-color: #BCB8A6; 
    }

    .right-navbar .dropdown:hover .dropdown-menu {
      display: block;
    }

    .settings-button {
      position: absolute;
      bottom: 10px;
      right: 10px;
      color: white;
      cursor: pointer;
    }

    .navbar-brand {

    }

    .settings-button a {
      color: white;
      text-decoration: none;
    }

    .settings-button a:hover {
      color: #ddd;
    }


  </style>
</head>
<body>
  <nav class="navbar navbar-dark bg-dark fixed-top right-navbar">
    <img src="static/CLEARPATH.png" alt="Logo" width="250px" height="300px" style="padding: 5px">
      <div class="container-fluid">
        <a class="navbar-brand" href="/clearpath">ClearPath</a>
        <div class="offcanvas-body">
          <ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
            {% if current_user.is_authenticated %}
              <li class="nav-item">
                <a class="nav-link" aria-current="page" href="/settings">Welcome {{ current_user.username }}</a>
              </li>
            {% else %}
              <li class="nav-item">
                <a class="nav-link" aria-current="page" href="/signin">Sign In</a>
              </li>
            {% endif %}
            <li class="nav-item text-white">
             <a class="nav-link" href="/contactus">Contact Us</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="favoritesDropdown" role="button" data-bs-toggle="dropdown">
                Favorites
              </a>
              <ul class="dropdown-menu" aria-labelledby="favoritesDropdown">
                <!-- HOME -->
                <li>
                  <a class="dropdown-item" data-bs-toggle="collapse" href="#homeForm" role="button" aria-expanded="false">Home</a>
                  <div class="collapse px-3" id="homeForm">
                    <form method="POST" action="/favorites/save">
                      <input type="hidden" name="category" value="Home">
                      <input class="form-control my-1" name="address" placeholder="Address" required>
                      <input class="form-control my-1" name="city" placeholder="City" required>
                      <input class="form-control my-1" name="state" placeholder="State" required>
                      <input class="form-control my-1" name="zip" placeholder="ZIP Code" required>
                      <input class="form-control my-1" name="country" placeholder="Country" required>
                      <button class="btn btn-sm btn-light my-2" type="submit">Save</button>
                    </form>
                  </div>
                </li>
                <!-- WORK -->
                <li>
                  <a class="dropdown-item" data-bs-toggle="collapse" href="#workForm" role="button" aria-expanded="false">Work</a>
                  <div class="collapse px-3" id="workForm">
                    <form method="POST" action="/favorites/save">
                      <input type="hidden" name="category" value="Work">
                      <input class="form-control my-1" name="address" placeholder="Address" required>
                      <input class="form-control my-1" name="city" placeholder="City" required>
                      <input class="form-control my-1" name="state" placeholder="State" required>
                      <input class="form-control my-1" name="zip" placeholder="ZIP Code" required>
                      <input class="form-control my-1" name="country" placeholder="Country" required>
                      <button class="btn btn-sm btn-light my-2" type="submit">Save</button>
                    </form>
                  </div>
                </li>
                <!-- SCHOOL -->
                <li>
                  <a class="dropdown-item" data-bs-toggle="collapse" href="#schoolForm" role="button" aria-expanded="false">School</a>
                  <div class="collapse px-3" id="schoolForm">
                    <form method="POST" action="/favorites/save">
                      <input type="hidden" name="category" value="School">
                      <input class="form-control my-1" name="address" placeholder="Address" required>
                      <input class="form-control my-1" name="city" placeholder="City" required>
                      <input class="form-control my-1" name="state" placeholder="State" required>
                      <input class="form-control my-1" name="zip" placeholder="ZIP Code" required>
                      <input class="form-control my-1" name="country" placeholder="Country" required>
                      <button class="btn btn-sm btn-light my-2" type="submit">Save</button>
                    </form>
                  </div>
                </li>
                <!-- SAVED -->
                <li>
                  <a class="dropdown-item" data-bs-toggle="collapse" href="#savedForm" role="button" aria-expanded="false">Saved</a>
                  <div class="collapse px-3" id="savedForm">
                    <form method="POST" action="/favorites/save">
                      <input type="hidden" name="category" value="Saved">
                      <input class="form-control my-1" name="address" placeholder="Address" required>
                      <input class="form-control my-1" name="city" placeholder="City" required>
                      <input class="form-control my-1" name="state" placeholder="State" required>
                      <input class="form-control my-1" name="zip" placeholder="ZIP Code" required>
                      <input class="form-control my-1" name="country" placeholder="Country" required>
                      <button class="btn btn-sm btn-light my-2" type="submit">Save</button>
                    </form>
                  </div>
                </li>
              </ul>
            </li>
          </ul>
        </div>
    </div>
  </nav>
</body>
</html>