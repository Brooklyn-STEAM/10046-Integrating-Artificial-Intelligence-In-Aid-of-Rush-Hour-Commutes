<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ category }} Address</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <div class="container mt-5">
    <h2 class="mb-4">{{ category }} Address</h2>

    {% with messages = get_flashed_messages() %}
      {% if messages %}
        <div class="alert alert-info">
          {% for message in messages %}
            {{ message }}<br>
          {% endfor %}
        </div>
      {% endif %}
    {% endwith %}

    <form method="POST">
      <div class="mb-3">
        <label class="form-label">Address</label>
        <input type="text" name="address" class="form-control" value="{{ data[category|lower + 'address'] if data else '' }}" required>
      </div>

      <div class="mb-3">
        <label class="form-label">City</label>
        <input type="text" name="city" class="form-control" value="{{ data.city if data else '' }}" required>
      </div>

      <div class="mb-3">
        <label class="form-label">State</label>
        <input type="text" name="state" class="form-control" value="{{ data.state if data else '' }}" required>
      </div>

      <div class="mb-3">
        <label class="form-label">ZIP Code</label>
        <input type="text" name="zip" class="form-control" value="{{ data.zip_code if data else '' }}" >
      </div>

      <div class="mb-3">
        <label class="form-label">Country</label>
        <input type="text" name="country" class="form-control" value="{{ data.country if data else '' }}" required>
      </div>

      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/" class="btn btn-secondary">Cancel</a>
    </form>
  </div>

</body>
</html>
